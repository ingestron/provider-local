{
  "name": "@ingestron/provider-local",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22 <23"
  },
  "packageManager": "pnpm@10.15.0",
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test test/*.test.mjs && python3 -m unittest discover -s test -p \"test_*.py\"",
    "format:check": "prettier --check .",
    "docs:check": "node scripts/docs-check.mjs",
    "secrets:check": "node scripts/secrets.mjs",
    "validate": "pnpm format:check && pnpm build && pnpm test && pnpm docs:check && pnpm secrets:check",
    "acceptance": "node scripts/execution-acceptance.mjs",
    "cli:install": "node scripts/install-cli.mjs"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "prettier": "3.9.6",
    "yaml": "2.9.0"
  },
  "description": "Local Python execution provider for Ingestron.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ingestron/provider-local.git"
  }
}
